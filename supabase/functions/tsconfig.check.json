{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true
  },
  "include": ["_check/**/*.d.ts", "_shared/**/*.ts", "diagnostic-*/**/*.ts"],
  "exclude": ["_shared/*_test.ts"]
}
